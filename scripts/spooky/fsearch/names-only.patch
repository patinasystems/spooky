+/// A subtree scan inherits the background role of its caller; on-demand
+/// scoped queries use the same scanner without being demoted to index work.
+pub(crate) fn scan_pool(threads: usize) -> rayon::ThreadPool {
+    let background = crate::engine::background_indexing();
+    rayon::ThreadPoolBuilder::new().num_threads(crate::engine::index_worker_count(threads)).start_handler(move |_| {
+        if background { crate::engine::background_index_worker(); } else { crate::no_materialize(); }
+    }).build().unwrap()
+}
