+
+struct IndexDiagnostics {
+    enabled: bool,
+    phase: AtomicUsize,
+    started: AtomicU64,
+    totals: [AtomicU64; 11],
+    ready: AtomicBool,
+    entries: AtomicUsize,
+    index_bytes: AtomicUsize,
+    batches: AtomicUsize,
+    events: AtomicUsize,
+    directories: AtomicUsize,
+    compactions: AtomicUsize,
+}
+
+impl IndexDiagnostics {
+    fn new() -> Self {
+        Self::with_enabled(std::env::var_os("SPOOKY_FSEARCH_DIAGNOSTICS_PATH").is_some())
+    }
+
+    fn with_enabled(enabled: bool) -> Self {
+        Self { enabled, phase: AtomicUsize::new(IndexPhase::Loading as usize),
+            started: AtomicU64::new(if enabled { now_ns() } else { 0 }),
+            totals: std::array::from_fn(|_| AtomicU64::new(0)), ready: AtomicBool::new(false),
+            entries: AtomicUsize::new(0), index_bytes: AtomicUsize::new(0), batches: AtomicUsize::new(0),
+            events: AtomicUsize::new(0), directories: AtomicUsize::new(0), compactions: AtomicUsize::new(0) }
+    }
+
+    fn enter(&self, phase: IndexPhase) {
+        if !self.enabled { return; }
+        let next = phase as usize;
+        let previous = self.phase.load(Ordering::Relaxed);
+        if previous == next { return; }
+        let now = now_ns();
+        let started = self.started.swap(now, Ordering::Relaxed);
+        self.totals[previous].fetch_add(now.saturating_sub(started), Ordering::Relaxed);
+        self.phase.store(next, Ordering::Relaxed);
+    }
+
+    fn publish(&self, index: (usize, usize)) {
+        if !self.enabled { return; }
+        self.entries.store(index.0, Ordering::Relaxed);
+        self.index_bytes.store(index.1, Ordering::Relaxed);
+        self.ready.store(true, Ordering::Relaxed);
+    }
+
+    fn snapshot(&self, replaying: bool) -> IndexDiagnosticSnapshot {
+        let phase = self.phase.load(Ordering::Relaxed);
+        let elapsed = if self.enabled { now_ns().saturating_sub(self.started.load(Ordering::Relaxed)) } else { 0 };
+        let mut totals = std::array::from_fn(|i| self.totals[i].load(Ordering::Relaxed));
+        totals[phase] = totals[phase].saturating_add(elapsed);
+        IndexDiagnosticSnapshot { enabled: self.enabled, phase: PHASE_NAMES[phase], phase_elapsed_ns: elapsed,
+            phase_names: PHASE_NAMES, phase_total_ns: totals, ready: self.ready.load(Ordering::Relaxed), replaying,
+            scanned_entries: walk::LISTED.load(Ordering::Relaxed), indexed_entries: self.entries.load(Ordering::Relaxed),
+            index_bytes: self.index_bytes.load(Ordering::Relaxed), event_batches: self.batches.load(Ordering::Relaxed),
+            events: self.events.load(Ordering::Relaxed), updated_directories: self.directories.load(Ordering::Relaxed),
+            compactions: self.compactions.load(Ordering::Relaxed) }
+    }
+}
