+        let record = serde_json::to_value(snapshot).unwrap();
+        assert_eq!(record.as_object().unwrap().len(), 14);
+        assert!(record.get("path").is_none() && record.get("query").is_none());
+        probe.enter(IndexPhase::Waiting);
+        assert_eq!(probe.snapshot(false).phase, "waiting");
+    }
+    #[test]
+    fn filename_helper_background_workers_preserve_on_demand_search_policy() {
+        fn current_qos() -> u32 {
+            let mut qos = libc::qos_class_t::QOS_CLASS_UNSPECIFIED;
+            assert_eq!(unsafe { libc::pthread_get_qos_class_np(libc::pthread_self(), &mut qos, std::ptr::null_mut()) }, 0);
+            qos as u32
+        }
+        configure_filename_helper_workers().unwrap();
+        configure_filename_helper_workers().unwrap();
+        assert_eq!(current_qos(), libc::qos_class_t::QOS_CLASS_UTILITY as u32);
+        assert!(!background_indexing());
+        assert_eq!(index_worker_count(12), 2);
+        assert_eq!(index_worker_count(1), 1);
+        let index_policy = (libc::qos_class_t::QOS_CLASS_BACKGROUND as u32, true);
+        let global = rayon::broadcast(|_| (current_qos(), background_indexing()));
+        assert_eq!(global.len(), 2);
+        assert!(global.iter().all(|&policy| policy == index_policy));
+        let stat = crate::live::stat_pool().broadcast(|_| (current_qos(), background_indexing()));
+        assert_eq!(stat.len(), 2);
+        assert!(stat.iter().all(|&policy| policy == index_policy));
+        let (tx, rx) = std::sync::mpsc::channel();
+        spawn("fsearch-policy-test", move || {
+            let subtree = walk::scan_pool(8).broadcast(|_| (current_qos(), background_indexing()));
+            tx.send(((current_qos(), background_indexing()), subtree)).unwrap();
+        });
+        let (apply, subtree) = rx.recv_timeout(Duration::from_secs(2)).unwrap();
+        assert_eq!(apply, index_policy);
+        assert_eq!(subtree.len(), 2);
+        assert!(subtree.iter().all(|&policy| policy == index_policy));
+        // The same subtree scan also serves an early scoped query. Its caller
+        // is a request worker, so it must retain the original utility policy.
+        let scoped = walk::scan_pool(8).broadcast(|_| (current_qos(), background_indexing()));
+        assert_eq!(scoped.len(), 2);
+        assert!(scoped.iter().all(|&policy| policy == (libc::qos_class_t::QOS_CLASS_UTILITY as u32, false)));
+        let search = names_pool().broadcast(|_| (current_qos(), background_indexing()));
+        assert_eq!(search.len(), 2);
+        assert!(search.iter().all(|&policy|
+            policy == (libc::qos_class_t::QOS_CLASS_USER_INITIATED as u32, false)));
+    }
