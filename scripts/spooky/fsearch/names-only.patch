+#[cfg(test)]
+mod spooky_index_diagnostic_tests {
+    use super::*;
+
+    #[test]
+    fn disabled_probe_records_no_work() {
+        let probe = IndexDiagnostics::with_enabled(false);
+        probe.enter(IndexPhase::Build);
+        probe.publish((100, 200));
+        let snapshot = probe.snapshot(false);
+        assert!(!snapshot.enabled && !snapshot.ready);
+        assert_eq!(snapshot.phase, "loading");
+        assert_eq!(snapshot.phase_total_ns, [0; 11]);
+        assert_eq!(snapshot.indexed_entries, 0);
+    }
+
+    #[test]
