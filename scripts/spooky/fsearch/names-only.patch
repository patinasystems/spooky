+static FILENAME_HELPER_WORKERS: AtomicBool = AtomicBool::new(false);
+
+pub fn configure_filename_helper_workers() -> Result<(), String> {
+    static CONFIGURED: std::sync::OnceLock<Result<(), String>> = std::sync::OnceLock::new();
+    CONFIGURED.get_or_init(|| {
