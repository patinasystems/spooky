 impl Query {
+    /// Literal fuzzy words for a filename picker, with no query-language syntax.
+    pub fn literal_names(s: &str) -> Query {
+        fn tokens(s: &str) -> Vec<Token> {
+            // The searcher's positive-token mask has eight bits, as in push_token.
+            let words: Vec<&str> = s.split_whitespace().collect();
+            words.into_iter().rev().take(8).collect::<Vec<_>>().into_iter().rev().map(|word| {
+                let text: Vec<u8> = word.bytes().map(|b| b.to_ascii_lowercase()).collect();
+                let mask = text.iter().fold(0, |m, &b| m | char_bit(b));
+                let mut token = Token { text, mask, mode: Mode::Fuzzy, negate: false, edits: 0, deep: false, start: 0, rest: 0, under: false };
+                token.set_typos(false);
+                token
+            }).collect()
+        }
+        Query {
+            tokens: tokens(s),
+            alt: if s.is_ascii() { None } else { other_form(s).map(|s| tokens(&s)) },
+            size: (0, u64::MAX), mtime: (0, u32::MAX), limit: 50,
+            ..Default::default()
+        }
+    }
+
